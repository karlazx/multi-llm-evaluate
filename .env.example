# 复制为 .env 并填入真实值（.env 已被 gitignore，绝不提交）。
# M0 阶段用 DeepSeek 的兼容端点跑通两种协议；正式接入时替换为各家的真实端点。

# ── OpenAI v1 协议（chat completions，兼容端点）──
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── Anthropic 协议（messages，兼容端点）──
ANTHROPIC_API_KEY=sk-xxxx
ANTHROPIC_AUTH_TOKEN=sk-xxxx
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── OpenAI v2（responses）协议：仅真实 OpenAI 提供，需填入真实 OpenAI key ──
# OPENAI_API_KEY=sk-real-openai-key   # 与 v1 共用，跑 openai:responses:<model> 时需指向 api.openai.com
