# ═══════════════════════════════════════════════════════
# 大模型评测平台 — NAS 部署环境变量
# 复制到 .env 并填入真实值
# ═══════════════════════════════════════════════════════

# ── PostgreSQL 密码（自定义一个强密码）──
PG_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ── 加密密钥（64位 hex = 32字节）──
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：这是 NAS 独立的新 key，和 Ubuntu 无关
ENCRYPTION_KEY=

# ── 模型 API 配置（从 Ubuntu 服务器 .env 复制）──
# 登录 Ubuntu: ssh ubuntu@<云服务器IP>
# 查看 key: cat ~/multi-llm-evaluate/.env 或 docker inspect multi-llm-evaluate

# DeepSeek 直连
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 胜算云中转
SSY_API_KEY=
SSY_BASE_URL=https://router.shengsuanyun.com/api/v1
