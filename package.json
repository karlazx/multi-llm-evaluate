{
  "name": "multi-llm-evaluate",
  "version": "0.2.0",
  "description": "用例驱动 + 多协议 API 跑测 + 三级评估（自动判分/AI 裁判/人工盲评）+ 报告导出 的私有大模型选型评测平台",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "m0": "tsx scripts/m0/demo.ts",
    "seed": "tsx server/src/seed.ts",
    "server": "tsx server/src/index.ts",
    "build:server": "tsc -p tsconfig.server.json && rm -rf server/dist/migrations && cp -r server/src/migrations server/dist/migrations",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0",
    "mathjs": "^15.2.0",
    "pg": "^8.23.0",
    "promptfoo": "^0.122.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
